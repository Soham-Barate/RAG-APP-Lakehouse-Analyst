# ============================================================
# E-commerce RAG Knowledge Assistant — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----- LLM Providers -----
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# Fallback LLM (Groq — Llama 3.1 70B)
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.1-70b-versatile

# ----- Reranker -----
COHERE_API_KEY=your-cohere-key-here
COHERE_RERANK_MODEL=rerank-english-v3.0

# ----- Vector Stores -----
# pgvector (Primary)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_ecommerce
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Pinecone (Secondary / Cloud)
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_INDEX_NAME=ecommerce-rag
PINECONE_ENVIRONMENT=us-east-1
PINECONE_CLOUD=aws

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95

# ----- Vector Store Selection -----
# Options: "pgvector", "pinecone", "both"
VECTOR_STORE_PROVIDER=pgvector

# ----- Observability -----
LANGSMITH_API_KEY=ls_your-langsmith-key-here
LANGSMITH_PROJECT=ecommerce-rag-prod
LANGSMITH_TRACING_V2=true

# ----- Application -----
APP_NAME=E-commerce RAG Assistant
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# ----- API Security -----
API_KEY_HEADER=X-API-Key
API_KEYS=dev-key-1,dev-key-2
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ----- Rate Limiting -----
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_TOKENS_PER_MINUTE=100000

# ----- RAG Pipeline -----
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
CHUNK_SIZE_PARENT=2000
CHUNK_SIZE_CHILD=256
CHUNK_OVERLAP=64
MAX_RETRIEVAL_ITERATIONS=3
RELEVANCE_THRESHOLD=0.4
CONFIDENCE_FLOOR=0.3

# ----- Ingestion -----
EMBEDDING_BATCH_SIZE=100
INGESTION_WORKERS=4

# ----- Frontend -----
STREAMLIT_PORT=8501
BACKEND_URL=http://localhost:8000
